# Backend Configuration
SECRET_KEY=django-insecure-smart-meeting-decision-tracker-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Leave blank or DB_ENGINE=sqlite3 for local SQLite)
DB_ENGINE=postgresql
DB_NAME=smdt_db
DB_USER=smdt_user
DB_PASSWORD=smdt_password
DB_HOST=localhost
DB_PORT=5432

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
